# Copy to .env and supply your private database connection string.
DATABASE_URL=

# Admin dashboard: Supabase project URL and publishable/anon key are browser-safe.
# ADMIN_EMAIL must match the email that completes Supabase Auth magic-link sign-in.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_EMAIL=

# Optional: enables AI roommate conversation.
# Keep real keys only in the ignored .env file, never in index.html or Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Used only if the primary Gemini model returns a temporary 503 error.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

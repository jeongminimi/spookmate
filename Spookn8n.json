    {
      "parameters": {
        "jsCode": "// 구글 시트의 A열 컬럼명(헤더)에 맞게 지정하세요. (예: '요괴이름' 또는 '이름')\n// 첫 번째 행이 헤더가 아니라면 A열 키 이름을 확인해 주세요.\nconst existingNames = $input.all()\n  .map(item => item.json['요괴이름'] || item.json['A'] || item.json['요괴 이름'])\n  .filter(Boolean); // 빈 값 제거\n\n// 중복 제거 후 쉼표로 연결된 문자열 생성\nconst uniqueNames = [...new Set(existingNames)].join(', ');\n\nreturn [\n  {\n    json: {\n      existing_monsters: uniqueNames\n    }\n  }\n];"
      },

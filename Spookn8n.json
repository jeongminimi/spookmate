    {
      "parameters": {
        "jsCode": "const inputItem = $input.first().json;\nlet rawText = inputItem.output || inputItem.text || '';\n\n// 1. 마크다운 백틱 제거\nrawText = rawText.replace(/```(?:json)?/gi, '').replace(/```/g, '').trim();\n\nlet parsedData = null;\n\n// 2. 표준 JSON 배열 ([ ... ]) 추출 시도\nconst arrayMatch = rawText.match(/\\[\\s*\\{[\\s\\S]*\\}\\s*\\]/);\nif (arrayMatch) {\n  try {\n    parsedData = JSON.parse(arrayMatch[0]);\n  } catch (e) {}\n}\n\n// 3. 배열 실패 시 개별 JSON 객체({ ... })들을 모두 추출\nif (!parsedData || !Array.isArray(parsedData) || parsedData.length === 0) {\n  const objectMatches = rawText.match(/\\{[\\s\\S]*?\\}(?=\\s*(?:,|\\{|\\]|$))/g);\n  if (objectMatches) {\n    parsedData = [];\n    for (const objStr of objectMatches) {\n      try {\n        parsedData.push(JSON.parse(objStr));\n      } catch (e) {}\n    }\n  }\n}\n\n// 4. 추출 실패 시 AI 원본 텍스트를 에러 메시지에 함께 출력하여 확인 가능하게 처리\nif (!parsedData || parsedData.length === 0) {\n  throw new Error(\"JSON 파싱 실패. AI 출력 원본 내용:\\n\" + rawText);\n}\n\n// 5. 다음 노드(Append row)로 전달\nreturn parsedData.map(item => ({ json: item }));"
      },
